# Copy to .env.local (local dev) or add in your host's dashboard (e.g. Vercel → Settings → Environment Variables).

# Public URL of the site, used for SEO metadata, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://yohartt.com

# --- Enquiry delivery (configure at least one; both can be on) ---

# Telegram: create a bot with @BotFather, add it to your sales chat/group,
# then put the bot token and the chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend (https://resend.com). ENQUIRY_EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=sales@yohartt.com
ENQUIRY_EMAIL_FROM=Yohartt Website <website@yohartt.com>
